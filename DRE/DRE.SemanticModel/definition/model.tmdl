model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["dEstruturaDRE","dPlanoConta","fOrcamento","fPrevisao","fLancamentos","dCalendario","CaminhoArquivo"]

annotation PBI_ProTooling = ["DevMode"]

ref table dEstruturaDRE
ref table dPlanoConta
ref table fOrcamento
ref table fPrevisao
ref table fLancamentos
ref table dCalendario
ref table Medidas
ref table auxMeta

ref cultureInfo pt-BR

