	measure 'Título página' = ```
			
			
			VAR vFilial = 
			CONCATENATEX( 
			    VALUES(dEstruturaDRE[empresa]),
			    dEstruturaDRE[empresa], ", "
			    )
			
			VAR vMesAno =
			    SELECTEDVALUE(dCalendario[MesAno])
			
			VAR vMeta =
			    MAXX(
			        SUMMARIZE(
			            auxMeta,
			            auxMeta[auxMeta],
			            auxMeta[auxMeta Campos]
			        ),
			        auxMeta[auxMeta]
			    )
			
			RETURN
			    "Realizado vs "
			        & vMeta
			        & " para "
			        & vFilial
			        & " no mês de "
			        & vMesAno
			```
		displayFolder: KPI's
		lineageTag: dc04d360-5ab1-4e2e-aafb-03b848bc0b3f

	measure 'Título Análise Temporal' =
			
			VAR vContaDRE = SELECTEDVALUE(dEstruturaDRE[contaGerencial])
			VAR vContaN1 = SELECTEDVALUE(dPlanoConta[descricaoN1])
			VAR vContaN2 = SELECTEDVALUE(dPlanoConta[descricaoN2])
			RETURN
			SWITCH(
			    TRUE(),
			    NOT ISBLANK(vContaN2), vContaN2,
			    NOT ISBLANK(vContaN1), vContaN1,
			    NOT ISBLANK(vContaDRE), vContaDRE,
			    BLANK(),
			    "= RESULTADO LÍQUIDO DO EXERCÍCIO"
			)
		displayFolder: KPI's
		lineageTag: c6d3cb08-a0ad-4c8c-8853-1a4fb0191b1e

	measure 'Subtitulo visual' = ```
			
			VAR vMesesNegativos = 
			COUNTROWS(
			    FILTER(
			        ALL(
			            dCalendario[MesAtual], dCalendario[MesNum]),
			            [% Meta vs Realizado] < 0
			    )
			    )
			VAR vMesesPositivos = 
			COUNTROWS(
			    FILTER(
			        ALL(dCalendario[MesAno], dCalendario[MesNum]),
			        [% Meta vs Realizado] >= 0 && NOT(ISBLANK([% Meta vs Realizado]))
			    )
			)
			VAR vAno = SELECTEDVALUE(dCalendario[Ano])
			RETURN
			" Em " &
			vAno &
			" batemos a meta em " &
			vMesesPositivos &
			" meses e ficamos abaixo do " &
			VALUES(auxMeta[auxMeta]) &
			" em " &
			vMesesNegativos &
			" meses:"
			
			```
		displayFolder: KPI's
		lineageTag: ec7109e2-2235-40e1-9bac-40763a08c330

	measure 'Subtitulo visual 2' = ```
			
			VAR vPiorMes = 
			CALCULATE(
			    TOPN(
			        1,
			        FILTER(VALUES(dCalendario[MesAno]), NOT(ISBLANK([$ Realizado]))),
			        [% Meta vs Realizado],
			        ASC
			    ),
			    ALL(dCalendario),
			    VALUES(dCalendario[Ano]))
			VAR vValorPiorMes = FORMAT(CALCULATE([% Meta vs Realizado], dCalendario[MesAno] = vPiorMes), "0.0%")
			RETURN
			" onde o pior mês foi " &
			vPiorMes &
			", com uma diferença de " &
			vValorPiorMes &
			" em relação ao "&
			VALUES(auxMeta[auxMeta])&
			" :"
			```
		displayFolder: KPI's
		lineageTag: fa7952a4-1a90-4cd9-9fd1-3a9830736853

	measure 'Subtitulo visual 3' =
			
			VAR vRealizadoYTD = FORMAT([$ Realizado YTD], "R$0,0")
			VAR vDif = FORMAT([% Meta vs Realizado YTD], "0.0%;0.0%")
			VAR vAno = SELECTEDVALUE(dCalendario[Ano])
			RETURN
			"No acumulado de " &
			vAno &
			" o realizado foi de " &
			vRealizadoYTD &
			" ("&
			vDif &
			IF([% Meta vs Realizado YTD] > 0, " acima do ", " abaixo do " &
			VALUES(auxMeta[auxMeta])&
			")")
		displayFolder: KPI's
		lineageTag: 52254811-c098-47e6-9359-b68ffcf5465b

