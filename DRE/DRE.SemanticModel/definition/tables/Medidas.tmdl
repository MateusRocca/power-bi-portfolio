	measure 'Card Mês Top 1' =
			
			VAR vTopMes =
			    CALCULATETABLE(
			        TOPN(
			            1,
			            ALL(dCalendario[MesAno]),
			            [Realizado Receita Bruta],
			            DESC
			        ),
			        ALL(dCalendario),
			        VALUES(dCalendario[Ano])
			    )
			
			RETURN
			    MAXX(
			        vTopMes,
			        dCalendario[MesAno]
			    )
		displayFolder: KPI's
		lineageTag: e18b1cae-78e7-429b-a628-6a01ed9f6d3f

