table Medidas
	lineageTag: d61b6a9f-d126-4683-b347-5523cad54423

	measure '$ Valor Total Lançamento' =
			
			//Essa medida multiplica o valor por 1 ou -1, assim o que é negativo continua negativo e positivo ..
			SUMX(
			    fLancamentos,
			    fLancamentos[valor] * RELATED(dPlanoConta[tipoLancamento]
			    ))
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Totais
		lineageTag: fc3dfaf8-8602-44e4-ac38-0ab8330bb8ef

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure '$ Realizado' = ```
			
			VAR vSubtotal = MAX(dEstruturaDRE[subtotal]) // máximo da linha (só há dois valores 0 ou 1)
			VAR vIndex = MAX(dEstruturaDRE[index]) // Máximo da linha (vai de 1 a 13)
			VAR vTotal = [$ Valor Total Lançamento] 
			VAR vDetalharN2 = SELECTEDVALUE(dPlanoConta[detalharN2])
			
			VAR vAcumulado =
			    CALCULATE(
			        //altera o contexto de filtro
			        [$ Valor Total Lançamento],
			            ALL(dEstruturaDRE), // só filtro externo
			            VALUES(dEstruturaDRE[empresa]), //respeitando filtro por empresa, n mistura acumulado
			            dEstruturaDRE[index] < vIndex // somar apenas os registros cujo índice seja menor que o índice da linha atual.
			    )
			
			RETURN
			SWITCH(
			    TRUE(),
			    vSubtotal = 1 && ISINSCOPE(dPlanoConta[descricaoN1]), BLANK(),
			    vDetalharN2 = 0 && ISINSCOPE(dPlanoConta[descricaoN2]), BLANK(),
			    vSubtotal = 0, vTotal, // Significa que é uma linha comum da DRE, retorna o vTotal (apenas o valor daquela linha).
			    vSubtotal = 1, vAcumulado // Significa que é uma linha de subtotal retorna o vAcumulado (a soma de tudo o que veio antes).
			)
			```
		formatString: \$#,0.00000;(\$#,0.00000);\$#,0.00000
		displayFolder: DRE
		lineageTag: 17da4a71-74e7-4014-95fe-2068b83fae23

		annotation PBI_FormatHint = {"currencyCulture":"es-US"}

	measure '$ Valor Total Orçado' =
			
