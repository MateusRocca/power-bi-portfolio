	measure '$ Meta YTD' =
			
			CALCULATE(
			    [$ Meta],
			    DATESYTD(dCalendario[Data])
			)
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: DRE
		lineageTag: 2147a9e3-3a4a-4eb9-aeca-1f1f0aee5c37

	measure '% Meta vs Realizado YTD' =
			
			VAR vMeta = CALCULATE([$ Meta YTD], dCalendario[dataPassada?] = TRUE())
			VAR vRealizado = [$ Realizado YTD]
			VAR vDif = vRealizado - vMeta
			RETURN
			DIVIDE(
			    vDif,
			    ABS(vMeta)
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: DRE
		lineageTag: 64709b74-e7b3-4dc7-8469-66ea9fe7ca90

