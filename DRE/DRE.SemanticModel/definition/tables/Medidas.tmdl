	measure '% Meta vs Realizado' = ```
			
			VAR vMeta = [$ Meta]
			VAR vRealizado = [$ Realizado]
			VAR vDif = vRealizado - vMeta
			VAR vResultado = 
			DIVIDE(
			    vDif,
			    ABS(vMeta)
			)
			RETURN
			IF(vRealizado, vResultado)
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: DRE
		lineageTag: 4e99b44a-c256-425b-af1f-6335cd77000e

	measure '$ Realizado YTD' =
			
			CALCULATE(
			    [$ Realizado],
			    DATESYTD(dCalendario[Data])
			)
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: DRE
		lineageTag: 4c5894af-7059-4695-92f6-62f698323bc2

