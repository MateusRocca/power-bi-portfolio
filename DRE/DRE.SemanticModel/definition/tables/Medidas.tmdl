	measure '$ Meta' =
			
			IF(
			    SELECTCOLUMNS(auxMeta, auxMeta[auxMeta Pedido]) = 0,
			    [$ Orçado],
			    [$ Previsto]
			)
		displayFolder: DRE
		lineageTag: 4d2716a5-aa69-4ac8-8e1a-c5a1db83c795

