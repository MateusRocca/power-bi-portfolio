				  #"Personalização adicionada" = Table.AddColumn(#"Texto aparado", "Produto e Sabor", each [Produto Simples] & " (" & [Sabor] & ")"),
				  #"Personalização adicionada 1" = Table.AddColumn(#"Personalização adicionada", "Produto Completo", each [Produto] & " (" & [Sabor] & ")"),
